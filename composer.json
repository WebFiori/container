{
    "name": "webfiori/container",
    "description": "A lightweight dependency injection container with auto-resolution.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ibrahim BinAlshikh",
            "email": "ibrahim@webfiori.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "WebFiori\\Container\\": "WebFiori/Container/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebFiori\\Container\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "scripts": {
        "test": "phpunit --configuration tests/phpunit.xml"
    }
}
